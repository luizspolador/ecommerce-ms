# ==============================================================
# E-COMMERCE MICROSERVICES - VARIÁVEIS DE AMBIENTE (OPCIONAIS)
# ==============================================================

# --------------------------------------------------------------
# 1. API GATEWAY (Segurança OAuth2 / Keycloak)
# --------------------------------------------------------------
# Secret gerado pelo Keycloak para o client 'api-gateway-client'.
# Se não informado, o fallback padrão 'ecommerce-client-secret' será utilizado.
KEYCLOAK_CLIENT_SECRET=sua_chave_gerada_no_keycloak

# --------------------------------------------------------------
# 2. NOTIFICATION SERVICE (E-mails Sandbox - Perfil Padrão / Dev)
# --------------------------------------------------------------
# O serviço utiliza por padrão o Mailtrap (https://mailtrap.io) para capturar
# e-mails de teste em sandbox sem disparar mensagens reais para clientes.
# Obtenha suas credenciais gratuitas em: Mailtrap > Inboxes > My Inbox > SMTP Settings
MAILTRAP_USERNAME=seu_usuario_mailtrap
MAILTRAP_PASSWORD=sua_senha_mailtrap

# --------------------------------------------------------------
# 3. NOTIFICATION SERVICE (E-mails Reais - Perfil Opcional 'prod')
# --------------------------------------------------------------
# Caso queira disparar e-mails reais via SMTP do Google utilizando o perfil prod:
# Crie uma Senha de App em: https://myaccount.google.com/apppasswords
GMAIL_USERNAME=seu_email@gmail.com
GMAIL_APP_PASSWORD=sua_senha_de_app_de_16_digitos
